    # ---------------------------------------------------------------------------
# SecureBank – environment variable reference
# Copy this file to .env and fill in real values before running the app.
# .env is git-ignored; this file is checked in as a template only.
# ---------------------------------------------------------------------------

# --- Profiling / ThreatMetrix ---
ORG_ID=your_org_id
PAGE_ID=your_page_id
PROFILING_SERVER=h.online-metrix.net

# --- Session-query API ---
API_KEY=your_api_key
API_BASE_URL=https://h-api-us.online-metrix.net

# --- Optional 4th demo user (leave blank to skip) ---
USER4_NAME=Your Full Name
USER4_EMAIL=your_email@example.com
USER4_PASSWORD=your_password

# --- Comma-separated list of emails that bypass session validation (leave blank for none) ---
VALIDATION_IGNORE_EMAILS=your_email@example.com
